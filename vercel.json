{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/masuk",
      "destination": "/masuk.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
